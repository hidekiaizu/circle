# Browser-safe Supabase settings. Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy projects may use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# PostgreSQL connection used only by Prisma migration/seed tooling.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# DIRECT_URL is also accepted for the existing local setup.
# DIRECT_URL=postgresql://postgres:password@host:5432/postgres
