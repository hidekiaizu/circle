generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id         String   @id @db.Text
  name       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  claimed    Boolean  @default(false)
  claimToken String   @unique(map: "people_claim_token_key") @map("claim_token") @db.Text
  claimTokenExpiresAt DateTime? @map("claim_token_expires_at") @db.Timestamptz(3)
  major      String?  @db.Text
  year       String?  @db.Text
  residence  String?  @db.Text
  hometown   String?  @db.Text
  clubs      String[] @default([])

  relationshipsAsA        Relationship[] @relation("RelationshipPersonA")
  relationshipsAsB        Relationship[] @relation("RelationshipPersonB")
  proposedRelationships   Relationship[] @relation("RelationshipProposer")
  account Account?
  sessions Session[]

  @@map("people")
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  personId String @unique @map("person_id") @db.Text
  username String @unique @db.Text
  passwordHash String @map("password_hash") @db.Text
  failedLogins Int @default(0) @map("failed_logins")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  tokenHash String @id @map("token_hash") @db.Text
  personId String @map("person_id") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("sessions")
}

model Relationship {
  id                 String   @id @db.Text
  personAId          String   @map("person_a_id") @db.Text
  personBId          String   @map("person_b_id") @db.Text
  category           Int      @db.SmallInt
  proposedByPersonId String   @map("proposed_by_person_id") @db.Text
  confirmed          Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  personA    Person @relation("RelationshipPersonA", fields: [personAId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  personB    Person @relation("RelationshipPersonB", fields: [personBId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  proposedBy Person @relation("RelationshipProposer", fields: [proposedByPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([personAId], map: "relationships_person_a_id_idx")
  @@index([personBId], map: "relationships_person_b_id_idx")
  @@index([proposedByPersonId], map: "relationships_proposed_by_person_id_idx")
  @@map("relationships")
}
